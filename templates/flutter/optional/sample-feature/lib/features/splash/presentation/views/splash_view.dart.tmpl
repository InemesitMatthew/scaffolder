import 'package:{{packageName}}/core/core.dart';
import 'package:{{packageName}}/features/features.dart';

class SplashView extends ConsumerStatefulWidget {
  const SplashView({super.key});

  @override
  ConsumerState<SplashView> createState() => _SplashViewState();
}

class _SplashViewState extends ConsumerState<SplashView> {
  @override
  void initState() {
    super.initState();
    Future<void>.delayed(const Duration(milliseconds: 900), () {
      if (!mounted) return;
      context.go(AppRoutes.home);
    });
  }

  @override
  Widget build(BuildContext context) {
    final bootstrap = ref.watch(bootstrapStatusProvider);
    return BaseScaffold(
      useSingleScroll: false,
      bg: Palette.bg,
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            TextWidget(
              '{{appTitle}}',
              fontSize: 28,
              fontWeight: Weight.w700,
              textColor: Palette.textPrimary,
            ),
            context.verticalSpace(12),
            bootstrap.when(
              data: (status) => TextWidget(
                status.message,
                textColor: Palette.textMuted,
              ),
              loading: () => TextWidget(
                'Loading…',
                textColor: Palette.textMuted,
              ),
              error: (error, _) => TextWidget(
                'Bootstrap failed',
                textColor: Palette.danger,
              ),
            ),
          ],
        ),
      ),
    );
  }
}
