import 'package:dio/dio.dart';
{{networkConfigImport}}
class ApiClient {
  ApiClient({Dio? dio})
      : _dio = dio ??
            Dio(
              BaseOptions(
                baseUrl: {{apiBaseUrlExpr}},
                connectTimeout: const Duration(seconds: 15),
                receiveTimeout: const Duration(seconds: 15),
              ),
            );

  final Dio _dio;

  Dio get dio => _dio;
}
