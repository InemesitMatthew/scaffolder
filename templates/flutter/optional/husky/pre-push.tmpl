#!/bin/sh
# Single-pass hook — no husky.sh re-exec (avoids wrong `sh` / WSL).
# Windows: prefer *.bat via cmd (FVM or PATH) — same strategy as pre-commit.
# Skip: HUSKY=0 git push ...
[ "${HUSKY:-1}" = "0" ] && exit 0

set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

SDK_DART_BAT="$ROOT/.fvm/flutter_sdk/bin/dart.bat"
WIN_SYSTEM32="/c/Windows/System32"
WIN_POWERSHELL="/c/Windows/System32/WindowsPowerShell/v1.0"
WIN_GIT_CMD="/c/Program Files/Git/cmd"
WIN_GIT_CMD_X86="/c/Program Files (x86)/Git/cmd"
# Minimal Windows PATH for *.bat (avoid appending ambient %PATH% — quote corruption).
WIN_CORE_PATH='set "PATH=C:\Windows\System32;C:\Windows\System32\WindowsPowerShell\v1.0;C:\Program Files\Git\cmd;C:\Program Files (x86)\Git\cmd"'

unix_to_win() {
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -w "$1"
  else
    echo "$1" | sed -e 's|^/\([a-zA-Z]\)/|\1:/|' -e 's|/|\\|g'
  fi
}

# POSIX sh (Git hooks use #!/bin/sh) does not resolve *.bat via `command -v`.
find_on_path() {
  name="$1"
  _old_ifs=$IFS
  IFS=:
  for _dir in $PATH; do
    if [ -n "$_dir" ] && [ -f "$_dir/$name" ]; then
      printf '%s\n' "$_dir/$name"
      IFS=$_old_ifs
      unset _old_ifs _dir name
      return 0
    fi
  done
  IFS=$_old_ifs
  unset _old_ifs _dir name
  return 1
}

FLUTTER_BAT="$(find_on_path flutter.bat || true)"
CMD_EXE="$(command -v cmd.exe || true)"
if [ -z "$CMD_EXE" ] && [ -f "$WIN_SYSTEM32/cmd.exe" ]; then
  CMD_EXE="$WIN_SYSTEM32/cmd.exe"
fi

# Ensure core Windows executables are available inside hook shells.
# Keep /usr/bin ahead of System32 so `env bash` never picks WSL bash.exe.
if [ -d "$WIN_SYSTEM32" ]; then
  PATH="/usr/bin:$WIN_SYSTEM32:$PATH"
fi
if [ -d "$WIN_POWERSHELL" ]; then
  PATH="$WIN_POWERSHELL:$PATH"
fi
if [ -d "$WIN_GIT_CMD" ]; then
  PATH="$WIN_GIT_CMD:$PATH"
elif [ -d "$WIN_GIT_CMD_X86" ]; then
  PATH="$WIN_GIT_CMD_X86:$PATH"
fi
export PATH

echo "Running pre-push test suite (unit + widget under test/)..."

if [ -f "$SDK_DART_BAT" ] && [ -n "$CMD_EXE" ]; then
  "$CMD_EXE" //c "$WIN_CORE_PATH && call .fvm\flutter_sdk\bin\flutter.bat test test/ --no-pub" || {
    echo ""
    echo "Unit/widget tests failed. Push aborted."
    exit 1
  }
elif [ -n "$CMD_EXE" ] && [ -n "$FLUTTER_BAT" ]; then
  FLUTTER_BAT_WIN="$(unix_to_win "$FLUTTER_BAT")"
  "$CMD_EXE" //c "$WIN_CORE_PATH && call $FLUTTER_BAT_WIN test test/ --no-pub" || {
    echo ""
    echo "Unit/widget tests failed. Push aborted."
    exit 1
  }
else
  if [ -d "$ROOT/.fvm/flutter_sdk/bin" ]; then
    PATH="$ROOT/.fvm/flutter_sdk/bin:$PATH"
    export PATH
  fi
  if [ -n "$CMD_EXE" ]; then
    echo "pre-push: could not find flutter.bat on PATH."
    echo "  Install Flutter or run: fvm install && fvm use"
    exit 1
  fi
  flutter test test/ --no-pub || {
    echo ""
    echo "Unit/widget tests failed. Push aborted."
    exit 1
  }
fi

# Uncomment when integration tests should block every push:
# echo "Running integration tests..."
# if [ -f "$SDK_DART_BAT" ] && [ -n "$CMD_EXE" ]; then
#   "$CMD_EXE" //c "$WIN_CORE_PATH && call .fvm\flutter_sdk\bin\flutter.bat test integration_test/ --no-pub" || exit 1
# elif [ -n "$CMD_EXE" ] && [ -n "$FLUTTER_BAT" ]; then
#   FLUTTER_BAT_WIN="$(unix_to_win "$FLUTTER_BAT")"
#   "$CMD_EXE" //c "$WIN_CORE_PATH && call $FLUTTER_BAT_WIN test integration_test/ --no-pub" || exit 1
# else
#   flutter test integration_test/ --no-pub || exit 1
# fi

echo ""
echo "All pre-push tests passed."
